{
  "rules": {
    "wastelanders": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'lat', 'lng', 'timestamp'])",
        "name":      { ".validate": "newData.isString() && newData.val().length <= 24" },
        "lat":       { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":       { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "hp":        { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "rads":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
        "radsLifetime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "mutations": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
        "glowingOne": { ".validate": "newData.isBoolean()" },
        "inMedZone": { ".validate": "newData.isBoolean()" },
        "inRadZone": { ".validate": "newData.isBoolean()" },
        "photosTaken": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "avatar":    { ".validate": "newData.isString() && newData.val().length <= 100000" },
        "$other":    { ".validate": false }
      }
    },
    "mail": {
      ".read": true,
      "$uid": {
        "$mailKey": {
          ".write": true,
          ".validate": "newData.hasChildren(['type', 'from', 'fromName', 'ts', 'payload'])",
          "type":      { ".validate": "newData.isString() && (newData.val() == 'msg' || newData.val() == 'quest' || newData.val() == 'item' || newData.val() == 'handshake' || newData.val() == 'quest-offer' || newData.val() == 'verify-request')" },
          "from":      { ".validate": "newData.isString() && newData.val().length <= 64" },
          "fromName":  { ".validate": "newData.isString() && newData.val().length <= 32" },
          "ts":        { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
          "payload":   { ".validate": true },
          "claimed":   { ".validate": "newData.isBoolean()" },
          "declined":  { ".validate": "newData.isBoolean()" },
          "fulfilled": { ".validate": "newData.isBoolean()" },
          "$other":    { ".validate": false }
        }
      }
    },
    "sharedpins": {
      ".read": true,
      "$pinId": {
        ".write": true,
        ".validate": "newData.hasChildren(['label', 'lat', 'lng', 'ts'])",
        "label":     { ".validate": "newData.isString() && newData.val().length <= 32" },
        "lat":       { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":       { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "ts":        { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "from":      { ".validate": "newData.isString() && newData.val().length <= 64" },
        "fromName":  { ".validate": "newData.isString() && newData.val().length <= 32" },
        "icon":      { ".validate": "newData.isString() && newData.val().length <= 24" },
        "permanent": { ".validate": "newData.isBoolean()" },
        "$other":    { ".validate": false }
      }
    },
    "pariahs": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['name', 'ts'])",
        "name":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "ts":        { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "$other":    { ".validate": false }
      }
    },
    "radzones": {
      ".read": true,
      "$zoneId": {
        ".write": true,
        ".validate": "newData.hasChildren(['label', 'lat', 'lng', 'ts'])",
        "label":     { ".validate": "newData.isString() && newData.val().length <= 32" },
        "lat":       { ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90" },
        "lng":       { ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180" },
        "ts":        { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "kind":      { ".validate": "newData.isString() && (newData.val() == 'hot' || newData.val() == 'med' || newData.val() == 'decon')" },
        "radius":    { ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 200" },
        "$other":    { ".validate": false }
      }
    },
    "radio": {
      ".read": true,
      "$sid": {
        ".write": true,
        ".validate": "newData.hasChildren(['epoch'])",
        "epoch":     { ".validate": "newData.isNumber() && newData.val() > 1735689600000 && newData.val() < 20000000000000" },
        "$other":    { ".validate": false }
      }
    },
    "announcements": {
      ".read": true,
      "latest": {
        ".write": true,
        ".validate": "newData.hasChildren(['text', 'from', 'ts'])",
        "text":      { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 140" },
        "from":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "ts":        { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "$other":    { ".validate": false }
      },
      "$other": { ".validate": false }
    },
    "world": {
      ".read": true,
      "starchedUnlocked": {
        ".write": true,
        ".validate": "newData.isBoolean()"
      },
      "$other": { ".validate": false }
    },
    "globalContracts": {
      ".read": true,
      "$contractId": {
        ".write": true,
        ".validate": "newData.hasChildren(['title', 'issuerUid', 'issuerName', 'type', 'status', 'createdAt'])",
        "title":           { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "description":     { ".validate": "newData.isString() && newData.val().length <= 500" },
        "issuerUid":       { ".validate": "newData.isString() && newData.val().length <= 64" },
        "issuerName":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "type":            { ".validate": "newData.isString() && (newData.val() == 'first' || newData.val() == 'many' || newData.val() == 'timed')" },
        "reward":          { ".validate": "newData.isString() && newData.val().length <= 100" },
        "expiresAt":       { ".validate": "newData.isNumber() || newData.val() == null" },
        "status":          { ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 'completed' || newData.val() == 'cancelled' || newData.val() == 'rejected')" },
        "completedBy":     { ".validate": true },
        "completedByName": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "verifiedBy":      { ".validate": "newData.isString() && newData.val().length <= 32" },
        "evidencePhoto":   { ".validate": "newData.isString()" },
        "createdAt":       { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "$other":          { ".validate": false }
      }
    },
    "quests": {
      ".read": true,
      "$questId": {
        ".write": true,
        "title":         { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
        "description":   { ".validate": "newData.isString() && newData.val().length <= 500" },
        "reward":        { ".validate": "newData.isString() && newData.val().length <= 100" },
        "type":          { ".validate": "newData.isString() && (newData.val() == 'direct' || newData.val() == 'global' || newData.val() == 'bounty' || newData.val() == 'multi-stage')" },
        "issuerUid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "issuerName":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "status":        { ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 'cancelled' || newData.val() == 'removed' || newData.val() == 'expired')" },
        "assignedTo":    { ".validate": "newData.isString() && newData.val().length <= 64" },
        "targetUid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "targetName":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "expiresAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
        "expiredAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
        "timeLimit":     { ".validate": "newData.isNumber() || newData.val() == null" },
        "hideLockedStages": { ".validate": "newData.isBoolean() || newData.val() == null" },
        "createdAt":     { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "removedReason": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "removedAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
        "removedBy":     { ".validate": "newData.isString() && newData.val().length <= 32" },
        "stages": {
          "$stageId": {
            ".validate": "newData.hasChildren(['type', 'title', 'status'])",
            "id":          { ".validate": "newData.isString() && newData.val().length <= 32" },
            "type":        { ".validate": "newData.isString() && (newData.val() == 'location' || newData.val() == 'bounty' || newData.val() == 'photo' || newData.val() == 'scan-code')" },
            "title":       { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100" },
            "description": { ".validate": "newData.isString() && newData.val().length <= 500" },
            "reward":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            "qrCode":      { ".validate": "newData.isString() && newData.val().length <= 100" },
            "targetUid":   { ".validate": "newData.isString() && newData.val().length <= 64" },
            "targetName":  { ".validate": "newData.isString() && newData.val().length <= 32" },
            "timeLimit":   { ".validate": "newData.isNumber() || newData.val() == null" },
            "status":      { ".validate": "newData.isString() && (newData.val() == 'available' || newData.val() == 'locked')" },
            "completedBy": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "completedAt": { ".validate": "newData.isNumber() || newData.val() == null" },
            "verifiedBy":  { ".validate": "newData.isString() && newData.val().length <= 64" },
            "verifiedAt":  { ".validate": "newData.isNumber() || newData.val() == null" },
            "$other":      { ".validate": false }
          }
        },
        "progress": {
          "$uid": {
            ".write": true,
            "acceptedAt":      { ".validate": "newData.isNumber()" },
            "status":          { ".validate": "newData.isString() && (newData.val() == 'accepted' || newData.val() == 'completed' || newData.val() == 'verified' || newData.val() == 'rejected' || newData.val() == 'abandoned')" },
            "completedAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
            "completedByName": { ".validate": "newData.isString() && newData.val().length <= 32" },
            "completedByScan": { ".validate": "newData.isBoolean() || newData.val() == null" },
            "evidencePhoto":   { ".validate": "newData.isString()" },
            "verifiedBy":      { ".validate": "newData.isString() && newData.val().length <= 64" },
            "verifiedByName":  { ".validate": "newData.isString() && newData.val().length <= 32" },
            "verifiedAt":      { ".validate": "newData.isNumber() || newData.val() == null" },
            "rejectedBy":      { ".validate": "newData.isString() && newData.val().length <= 64" },
            "rejectedAt":      { ".validate": "newData.isNumber() || newData.val() == null" },
            "abandonedAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
            "stages": {
              "$stageId": {
                ".write": true,
                "status":        { ".validate": "newData.isString() && (newData.val() == 'available' || newData.val() == 'locked' || newData.val() == 'completed')" },
                "completedAt":   { ".validate": "newData.isNumber() || newData.val() == null" },
                "evidencePhoto": { ".validate": "newData.isString()" },
                "evidenceScan":  { ".validate": "newData.isString()" },
                "$other":        { ".validate": false }
              }
            },
            "$other":          { ".validate": false }
          }
        },
        "$other":        { ".validate": false }
      }
    },
    "bounties": {
      ".read": true,
      "$bountyId": {
        ".write": true,
        ".validate": "newData.hasChildren(['targetUid', 'targetName', 'issuerUid', 'issuerName', 'status', 'createdAt'])",
        "targetUid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "targetName":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "issuerUid":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "issuerName":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "reason":        { ".validate": "newData.isString() && newData.val().length <= 200" },
        "reward":        { ".validate": "newData.isString() && newData.val().length <= 100" },
        "expiresAt":     { ".validate": "newData.isNumber() || newData.val() == null" },
        "status":        { ".validate": "newData.isString() && (newData.val() == 'open' || newData.val() == 'claimed' || newData.val() == 'cancelled')" },
        "claimedBy":     { ".validate": "newData.isString() && newData.val().length <= 64" },
        "claimedByName": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "claimedAt":     { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "verifiedBy":    { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt":     { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "$other":        { ".validate": false }
      }
    },
    "surrenderCodes": {
      ".read": true,
      "$uid": {
        ".write": true,
        ".validate": "newData.hasChildren(['code', 'generatedAt'])",
        "code":        { ".validate": "newData.isString() && newData.val().length == 6" },
        "generatedAt": { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
        "$other":      { ".validate": false }
      }
    },
    "chronicle": {
      ".read": true,
      "entries": {
        "$entryId": {
          ".write": true,
          ".validate": "newData.hasChildren(['timestamp', 'eventType', 'narrative'])",
          "timestamp":     { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
          "eventType":     { ".validate": "newData.isString() && newData.val().length <= 32" },
          "narrative":     { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "affectedUsers": { ".validate": "newData.isString()" },
          "relatedPhotos": { ".validate": "newData.isString()" },
          "locationData":  { ".validate": "newData.isString()" },
          "day":           { ".validate": "newData.isNumber()" },
          "$other":        { ".validate": false }
        }
      },
      "rawEvents": {
        "$eventId": {
          ".write": true,
          ".validate": "newData.hasChildren(['timestamp', 'eventType', 'userId'])",
          "timestamp":  { ".validate": "newData.isNumber() && newData.val() > 1735689600000" },
          "eventType":  { ".validate": "newData.isString() && newData.val().length <= 32" },
          "userId":     { ".validate": "newData.isString() && newData.val().length <= 64" },
          "userName":   { ".validate": "newData.isString() && newData.val().length <= 32" },
          "data":       { ".validate": "newData.isString()" },
          "$other":     { ".validate": false }
        }
      },
      "$other": { ".validate": false }
    },
    "$other": { ".read": false, ".write": false }
  }
}
